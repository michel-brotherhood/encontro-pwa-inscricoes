NODE_ENV=development
PORT=3000
# Runtime URL: role event_app, no owner/superuser privileges.
DATABASE_URL=postgres://event_app:REPLACE_WITH_64_HEX_CHARS@localhost:5432/event
# Used only by scripts/db:init; this account must be allowed to manage schema and roles.
DATABASE_MIGRATION_URL=postgres://event:REPLACE_WITH_DB_PASSWORD@localhost:5432/event
DB_PASSWORD=REPLACE_WITH_STRONG_MIGRATION_PASSWORD
APP_DB_PASSWORD=REPLACE_WITH_64_HEX_CHARS
EVENT_KEY=encontro-janeiro-2027
EVENT_TITLE=Encontro de Ideias
EVENT_MONTH_START=2027-01-01
# Leave empty until the organizer confirms the day.
EVENT_DATE=
EVENT_START_TIME=11:00
EVENT_VENUE=Clube Canto do Rio
REGISTRATION_LIMIT=
ADMIN_EMAIL=organizador@example.com
ADMIN_PASSWORD_SALT=REPLACE_WITH_GENERATED_SALT
ADMIN_PASSWORD_HASH=REPLACE_WITH_GENERATED_HASH
SESSION_TTL_HOURS=8
CONSENT_VERSION=v1
TRUST_PROXY=false
